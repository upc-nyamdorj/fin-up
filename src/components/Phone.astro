---
import type { ImageMetadata } from "astro";
import { Picture } from "astro:assets";

interface Props {
  src?: ImageMetadata;
  alt?: string;
  /** rendered width of the screen image, for the responsive `sizes` attribute */
  sizes?: string;
  /** above-the-fold image: load eagerly with high fetch priority */
  priority?: boolean;
  class?: string;
}

const { src, alt = "", sizes = "262px", priority = false, class: className = "" } = Astro.props;
---

<div
  class:list={[
    "relative w-[280px] rounded-[46px] p-[9px] bg-linear-160 from-[#24324a] to-[#0b1426]",
    "shadow-[0_50px_100px_-20px_rgb(0_0_0/.65),0_0_0_1px_rgb(255_255_255/.1),0_0_90px_-10px_rgb(1_174_118/.35)]",
    "before:absolute before:top-[19px] before:left-1/2 before:-translate-x-1/2 before:z-10 before:h-6 before:w-[84px] before:rounded-full before:bg-[#05080f]",
    className,
  ]}
>
  <slot>
    {src && (
      <Picture
        src={src}
        alt={alt}
        formats={["avif", "webp"]}
        widths={[240, 360, 540, 720]}
        sizes={sizes}
        quality={70}
        loading={priority ? "eager" : "lazy"}
        fetchpriority={priority ? "high" : "auto"}
        decoding={priority ? "sync" : "async"}
        class="block w-full aspect-[1572/3376] rounded-[38px] object-cover"
      />
    )}
  </slot>
</div>
