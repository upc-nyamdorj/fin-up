---
interface Props {
  eyebrow: string;
  class?: string;
}

const { eyebrow, class: className = "mb-14" } = Astro.props;
---

<div class:list={["max-w-[620px]", className]}>
  <span class="flex items-center gap-3 text-xs font-semibold tracking-[.2em] text-mint uppercase" data-reveal>
    <span class="h-px w-8 bg-mint/60"></span>{eyebrow}
  </span>
  <h2 data-split class="mt-3.5 mb-4.5 text-[clamp(30px,4vw,48px)] font-bold leading-[1.1] tracking-[-.03em]"><slot name="title" /></h2>
  <p class="text-muted" data-reveal><slot /></p>
</div>
