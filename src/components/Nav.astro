---
const links = [
  { href: "#products", label: "Бүтээгдэхүүн" },
  { href: "#features", label: "Давуу тал" },
  { href: "#calc", label: "Тооцоолуур" },
  { href: "#faq", label: "Асуулт" },
  { href: "#guide", label: "Заавар" },
];
---

<nav id="nav" class="sticky top-0 z-50 px-3 pt-3">
  <div class="glass-dark mx-auto flex h-14 w-[min(1180px,100%)] items-center justify-between rounded-full pr-2 pl-6">
    <a href="#" class="font-display text-[24px] font-bold tracking-[-.04em] text-white">Fin<span class="text-mint">Up</span></a>

    <div class="hidden gap-1 text-sm text-muted lg:flex">
      {links.map((l) => (
        <a href={l.href} class="rounded-full px-4 py-2 transition-colors duration-300 hover:bg-white/10 hover:text-ink">
          {l.label}
        </a>
      ))}
    </div>

    <div class="flex items-center gap-3.5">
      <a data-magnetic data-app-link href="#app" class="btn-gloss group relative overflow-hidden rounded-full px-5 py-2.5 font-display text-sm font-semibold">
        <span class="absolute inset-y-0 left-0 w-1/3 bg-white/40 animate-shimmer"></span>
        <span class="relative">Апп татах</span>
      </a>
    </div>
  </div>
</nav>

<script>
  import { gsap, ScrollTrigger, onIdle } from "../scripts/motion";

  // hide on scroll down, show on scroll up
  const nav = document.getElementById("nav")!;
  const show = gsap.from(nav, { yPercent: -100, paused: true, duration: 0.4, ease: "power3.out" }).progress(1);
  onIdle(() => ScrollTrigger.create({
    start: 120,
    end: "max",
    onUpdate: (self) => (self.direction === -1 ? show.play() : show.reverse()),
  }));
</script>
