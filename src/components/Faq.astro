---
import SectionHead from "./SectionHead.astro";
import { contact } from "../data/site";

// Questions are from the docx. Answers 1–5 are from FinUp; 6–7 are drafts still to be confirmed.
const faqs = [
  {
    q: "Зээл авахад ямар шаардлага тавигддаг вэ?",
    a: "Та сүүлийн 6 сарын хугацаанд НДШ төлсөн байх бөгөөд өр орлогын харьцаа (ӨОХ) 55%, 45% байх хэрэгтэй шүү.",
  },
  {
    q: "Зээлийн тодорхойлолт хэрхэн авах вэ?",
    a: "FinUp аппликейшны “Тохиргоо” цэсийн “Тодорхойлолт” авах хэсгээс авна.",
  },
  {
    q: "Эргэн төлөлтөө хэрхэн хийх вэ?",
    a: "FinUp аппликейшны “Миний зээл” цэсээс төлөлт хийх зээлээ сонгон, өөрийн ашигладаг банкны аппликейшнаар дамжуулж төлөх боломжтой.",
  },
  {
    q: "Зээлээ сунгах боломжтой юу?",
    a: "Зээлээ нийт 3 удаа сунгах боломжтой бөгөөд нэг удаагийн сунгалт нь 1 сараар сунгагдана.",
  },
  {
    q: "Хугацаанаасаа өмнө зээлээ бүрэн хааж болох уу?",
    a: "Боломжтой шүү.",
  },
  {
    q: "Зээлийн эрхээ хэрхэн тооцоолуулах вэ?",
    a: "Баталгаажуулалтаа хийсний дараа нүүр хуудасны “Зээлийн дүн тооцох” товчийг дарахад танд олгох боломжит зээлийн дүн тооцогдоно.",
  },
  {
    q: "Зээлийн эрхээ хэрхэн нэмэгдүүлэх вэ?",
    a: "Зээлээ хугацаанд нь төлж, эерэг зээлийн түүх бүрдүүлэх нь зээлийн эрх нэмэгдэхэд нөлөөлнө.",
  },
];
---

<section id="faq" class="relative py-16 sm:py-20 lg:py-24">
  <div class="mx-auto grid w-[min(1180px,100%-32px)] gap-12 lg:grid-cols-[.8fr_1.2fr] lg:gap-20">
    <div class="lg:sticky lg:top-28 lg:self-start">
      <SectionHead eyebrow="Түгээмэл асуулт" class="mb-8">
        <Fragment slot="title">Танд асуулт<br />байна уу?</Fragment>
        Хариултаа олохгүй бол бидэнтэй холбогдоорой.
      </SectionHead>
      <div class="flex flex-wrap gap-3" data-reveal>
        <a data-magnetic href={`mailto:${contact.email}`} class="glass rounded-full px-5 py-3 font-display text-sm font-semibold transition-colors hover:text-mint">{contact.email}</a>
        <a data-magnetic href={`tel:${contact.phone.replace("-", "")}`} class="glass rounded-full px-5 py-3 font-display text-sm font-semibold transition-colors hover:text-mint">{contact.phone}</a>
      </div>
    </div>

    <div class="grid gap-3" data-stagger>
      {faqs.map((f, i) => (
        <div data-faq data-reveal class="spotlight glass group rounded-[24px] data-[open]:border-mint/40 data-[open]:[--tint:rgb(1_174_118/.18)]">
          <button type="button" aria-expanded="false" aria-controls={`faq-${i}`} class="flex w-full cursor-pointer items-center gap-5 px-6 py-5.5 text-left">
            <span class="font-display text-sm font-bold text-white/20 tabular-nums transition-colors group-data-[open]:text-mint">0{i + 1}</span>
            <span class="flex-1 font-display font-semibold sm:text-lg">{f.q}</span>
            <span class="relative grid size-9 shrink-0 place-items-center rounded-full border border-white/10 transition-[transform,background-color,border-color] duration-500 group-data-[open]:rotate-[135deg] group-data-[open]:border-mint group-data-[open]:bg-mint">
              <span class="absolute h-px w-3.5 bg-current group-data-[open]:bg-forest"></span>
              <span class="absolute h-3.5 w-px bg-current group-data-[open]:bg-forest"></span>
            </span>
          </button>
          <div id={`faq-${i}`} data-faq-body class="h-0 overflow-hidden">
            <p class="px-6 pb-6 pl-[68px] text-muted">{f.a}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  import { gsap, ScrollTrigger, reduce } from "../scripts/motion";

  const items = [...document.querySelectorAll<HTMLElement>("[data-faq]")];

  function toggle(item: HTMLElement, open: boolean) {
    const body = item.querySelector<HTMLElement>("[data-faq-body]")!;
    item.toggleAttribute("data-open", open);
    item.querySelector("button")!.setAttribute("aria-expanded", String(open));
    gsap.to(body, {
      height: open ? "auto" : 0,
      duration: reduce ? 0 : 0.6,
      ease: "expo.inOut",
      onComplete: () => ScrollTrigger.refresh(),
    });
    if (open && !reduce) gsap.from(body.firstElementChild, { y: 12, opacity: 0, duration: 0.6, delay: 0.15, ease: "expo.out" });
  }

  items.forEach((item) =>
    item.querySelector("button")!.addEventListener("click", () => {
      const opening = !item.hasAttribute("data-open");
      items.forEach((other) => other !== item && other.hasAttribute("data-open") && toggle(other, false));
      toggle(item, opening);
    }),
  );
</script>
