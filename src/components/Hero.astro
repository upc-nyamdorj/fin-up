---
import Phone from "./Phone.astro";
import Swirl from "./Swirl.astro";
import { stores } from "../data/site";
import homeScreen from "../assets/screens/screen-1.jpg";
import loginScreen from "../assets/screens/screen-3.jpg";

const chip = "glass-dark relative flex items-center gap-3 overflow-hidden whitespace-nowrap rounded-2xl px-4 py-3 text-sm font-semibold text-white";
---

<header id="hero" class="relative overflow-hidden pt-14 pb-10 sm:pb-28 lg:pt-22">
  <!-- aurora -->
  <div class="pointer-events-none absolute inset-0 -z-10 overflow-hidden">
    <div class="absolute -top-40 right-[-10%] size-[560px] rounded-full bg-green/25 blur-[130px] animate-aurora-1"></div>
    <div class="absolute top-[30%] right-[25%] size-[380px] rounded-full bg-mint/10 blur-[120px] animate-aurora-2"></div>
    <div class="absolute -bottom-32 -left-32 size-[480px] rounded-full bg-ocean/80 blur-[120px] animate-aurora-3"></div>
  </div>
  <div id="cursor-glow" class="pointer-events-none absolute top-0 left-0 -z-10 size-[420px] -translate-1/2 rounded-full bg-mint/10 opacity-0 blur-[100px] transition-opacity duration-700"></div>

  <div class="mx-auto grid w-[min(1180px,100%-32px)] items-center gap-12 lg:grid-cols-[1.05fr_.95fr]">
    <div data-hero-copy>
      <h1 class="mb-7 text-[clamp(46px,6.6vw,84px)] font-extrabold leading-none tracking-[-.045em] uppercase">
        <span class="block overflow-hidden pb-[.08em]"><span data-hero-line="a" data-in="rise" style="--d:100ms" class="block">Санхүүдээ</span></span>
        <span class="block pb-[.08em]"><span data-hero-line="b" class="inline-flex">
          <span class="sr-only">үсрэлт</span>
          {[..."үсрэлт"].map((ch, i) => <span aria-hidden="true" class="jump-letter" style={`--i:${i}`}>{ch}</span>)}
        </span></span>
        <span class="block overflow-hidden pb-[.08em]"><span data-hero-line="c" data-in="rise" style="--d:400ms" class="block text-white">хийе</span></span>
      </h1>

      <p data-in="fade" style="--d:600ms" class="max-w-[480px] text-lg text-muted">
        Хуучин хэмнэлдээ баригдалгүйгээр <strong class="font-semibold text-ink">хүссэн оргил, шинэ боломж өөд зоригтой үсрээрэй.</strong>
      </p>

      <div id="app" data-in="fade" style="--d:720ms" class="mt-10 flex flex-wrap gap-3.5">
        {stores.map((s, i) => (
          <a
            data-magnetic
            href={s.href}
            target="_blank"
            rel="noopener"
            class:list={[
              "group relative inline-flex items-center gap-3 overflow-hidden rounded-full px-6 py-3.5 font-display font-semibold transition-[box-shadow,border-color,color]",
              i === 0
                ? "btn-gloss hover:shadow-[0_10px_50px_-6px_rgb(96_224_130/.8)]"
                : "glass hover:text-mint",
            ]}
          >
            {i === 0 && <span class="absolute inset-y-0 left-0 w-1/3 bg-white/40 animate-shimmer"></span>}
            <svg class="relative size-5 fill-current" viewBox="0 0 24 24"><path d={s.icon} /></svg>
            <span class="relative">{s.label}</span>
          </a>
        ))}
      </div>
    </div>

    <div data-hero-stage data-tilt-zone class="relative grid min-h-[540px] place-items-center sm:min-h-[640px]">
      <Swirl name="loops" data-in="draw" style="--d:300ms" loading="eager" sizes="(min-width: 1024px) 960px, 125vw" class="absolute top-[30%] left-[-12%] w-[125%] opacity-95 lg:top-[33%] lg:left-[-41%] lg:w-[178%]" />
      <div data-in="ring" class="absolute aspect-square w-[360px] sm:w-[560px]">
        <div class="size-full rounded-full border border-dashed border-mint/20 animate-spin-slow after:absolute after:-top-[5px] after:left-1/2 after:size-2.5 after:rounded-full after:bg-mint after:shadow-[0_0_20px_var(--color-mint)]"></div>
      </div>
      <div data-in="ring" style="--d:120ms" class="absolute aspect-square w-[290px] sm:w-[430px]">
        <div class="size-full rounded-full border border-white/5 animate-spin-rev after:absolute after:bottom-[14%] after:left-[6%] after:size-1.5 after:rounded-full after:bg-green after:shadow-[0_0_14px_var(--color-green)]"></div>
      </div>

      <div data-in="slide" style="--d:350ms" class="absolute -translate-x-20 translate-y-8 -rotate-8 brightness-90 sm:-translate-x-28">
        <Phone src={loginScreen} alt="FinUp нэвтрэх дэлгэц" sizes="(min-width: 640px) 222px, 182px" priority class="w-[200px] sm:w-[240px]" />
      </div>

      <div data-in="phone" style="--d:200ms" class="relative z-10 translate-x-8 sm:translate-x-16">
        <div data-tilt="12">
          <div class="relative animate-float">
            <Phone src={homeScreen} alt="FinUp нүүр дэлгэц — тооцсон зээлийн дүн 15,000,000₮" sizes="(min-width: 640px) 262px, 222px" priority class="w-[240px] sm:w-[280px]" />
            <span data-glare class="pointer-events-none absolute inset-0 z-20 rounded-[46px] opacity-0 mix-blend-overlay transition-opacity duration-500 [background:radial-gradient(circle_at_var(--gx,50%)_var(--gy,50%),rgb(255_255_255/.55),transparent_45%)]"></span>
          </div>
        </div>
      </div>

      <div data-in="pop" style="--d:900ms" class="absolute top-[2%] left-0 z-20 origin-left scale-90 sm:top-[20%] sm:scale-100 lg:-left-[4%]">
        <div class="animate-float-slow [animation-direction:reverse]">
          <div class={chip}>
            <span class="pointer-events-none absolute inset-y-0 left-0 w-1/3 bg-white/15 animate-shimmer"></span>
            <span class="relative grid size-9 place-items-center rounded-[10px] bg-mint font-bold text-forest shadow-[0_0_20px_rgb(96_224_130/.6)]">✓</span>
            <div class="relative">ДАН баталгаажлаа<small class="block text-xs font-normal text-white/80">Иргэний үнэмлэх · Гарын үсэг</small></div>
          </div>
        </div>
      </div>
      <div data-in="pop" style="--d:1050ms" class="absolute right-0 bottom-[2%] z-20 origin-right scale-90 sm:bottom-[12%] sm:scale-100 lg:-right-[4%]">
        <div class="animate-float-slow">
          <div class={chip}>
            <span class="pointer-events-none absolute inset-y-0 left-0 w-1/3 bg-white/15 animate-shimmer [animation-delay:1.5s]"></span>
            <span class="relative grid size-9 place-items-center rounded-[10px] bg-mint font-bold text-forest shadow-[0_0_20px_rgb(96_224_130/.6)]">₮</span>
            <div class="relative">Зээлийн дүн тооцогдлоо<small class="block font-display text-[15px] font-bold text-mint">15,000,000₮</small></div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- scroll hint -->
  <div data-in="fade" style="--d:1000ms" class="absolute bottom-8 left-1/2 hidden -translate-x-1/2 flex-col items-center gap-2 text-[11px] tracking-[.25em] text-muted uppercase lg:flex">
    Scroll
    <span class="relative block h-10 w-px overflow-hidden bg-white/10">
      <span class="absolute inset-x-0 top-0 h-1/2 bg-mint animate-drop"></span>
    </span>
  </div>
</header>
