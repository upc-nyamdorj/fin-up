---
import { Image } from "astro:assets";
import { contact } from "../data/site";
import logo from "../assets/logo.png";

const socials = [
  { label: "Facebook", href: contact.facebook, path: "M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z" },
  { label: "Messenger", href: contact.messenger, path: "M12 3C7 3 3 6.7 3 11.3c0 2.6 1.3 4.9 3.3 6.4V21l3-1.7c.9.3 1.8.4 2.7.4 5 0 9-3.7 9-8.4S17 3 12 3zM7.5 13.5l3-3.2 2 2 3.5-2.3-3 3.2-2-2z" },
  { label: "Instagram", href: contact.instagram, path: "M7 3h10a4 4 0 0 1 4 4v10a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4V7a4 4 0 0 1 4-4zm5 5a4 4 0 1 0 0 8 4 4 0 0 0 0-8zm5.5-1.5h.01" },
];

const info = [
  { href: `mailto:${contact.email}`, text: contact.email, path: "M3 6h18v12H3zM3 7l9 6 9-6" },
  { href: `tel:${contact.phone.replace("-", "")}`, text: contact.phone, path: "M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2" },
  { href: "https://maps.google.com/?q=Monnis+Building+Ulaanbaatar", text: contact.address, path: "M12 21s-7-6.2-7-12a7 7 0 0 1 14 0c0 5.8-7 12-7 12zm0-9.5a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5z" },
];
---

<footer class="relative px-3 pb-3 text-sm text-muted">
  

  <div class="glass-dark mx-auto w-[min(1180px,100%)] rounded-[36px] px-6 pt-12 pb-7 sm:px-10">
    <div class="grid items-center gap-10 md:grid-cols-[1fr_auto_1fr] md:gap-12" data-stagger>
      <a href="#" aria-label="FinUp — дээш буцах" data-cursor-label="Дээш ↑" class="group relative order-first justify-self-center md:order-none md:col-start-2" data-reveal>
        <span class="pointer-events-none absolute inset-0 -z-10 scale-150 rounded-full bg-mint/15 opacity-60 blur-[60px] transition-opacity duration-500 group-hover:opacity-100"></span>
        <Image src={logo} alt="FinUp" width={300} densities={[1, 2]} class="block h-[clamp(56px,8vw,104px)] w-auto transition-transform duration-500 group-hover:-translate-y-1" />
      </a>

      <div class="text-center md:col-start-1 md:row-start-1 md:text-left" data-reveal>
        <p class="font-display text-lg font-semibold text-ink">Санхүүдээ үсрэлт хийе</p>
        <div class="mt-4 flex justify-center gap-2.5 md:justify-start">
          {socials.map((s) => (
            <a data-magnetic href={s.href} target="_blank" rel="noopener" aria-label={s.label} class="glass grid size-10 place-items-center rounded-full text-ink transition-colors duration-300 hover:bg-mint hover:text-forest">
              <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d={s.path} /></svg>
            </a>
          ))}
        </div>
      </div>

      <ul class="grid w-full content-start gap-0.5 rounded-3xl bg-white/5 p-2 md:col-start-3 md:row-start-1 md:w-auto md:justify-self-end md:bg-transparent md:p-0" data-reveal>
        {info.map((i) => (
          <li>
            <a href={i.href} target={i.href.startsWith("http") ? "_blank" : undefined} rel="noopener" class="group flex min-h-11 max-w-[340px] items-start gap-3 rounded-2xl px-3 py-3 transition-colors hover:bg-white/5 hover:text-ink md:px-0 md:py-2 md:hover:bg-transparent">
              <svg class="mt-0.5 size-4 shrink-0 text-mint transition-transform duration-300 group-hover:scale-125" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d={i.path} /></svg>
              <span class="leading-snug">{i.text}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>

    <div class="mt-10 flex flex-col items-center justify-between gap-1 border-t border-white/10 pt-6 text-center text-xs sm:flex-row sm:text-left">
      <span>Си И Си Инвестмент ХХК © 2026. Бүх эрх хуулиар хамгаалагдсан</span>
      <div class="flex gap-5">
        <a href="/terms" class="inline-flex min-h-11 items-center transition-colors hover:text-mint">Үйлчилгээний нөхцөл</a>
        <a href="/privacy" class="inline-flex min-h-11 items-center transition-colors hover:text-mint">Нууцлалын бодлого</a>
      </div>
    </div>
  </div>
</footer>
