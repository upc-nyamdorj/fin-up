---
import "@fontsource-variable/manrope";
import "../styles/global.css";
import manropeCyrillic from "@fontsource-variable/manrope/files/manrope-cyrillic-wght-normal.woff2?url";
import { appLinks, contact, faqs } from "../data/site";

interface Props {
  title: string;
  description: string;
  /** splash intro; off for secondary pages */
  intro?: boolean;
}

const { title, description, intro = true } = Astro.props;
// build.format "file" gives /terms.html; the served URL is /terms (cleanUrls)
const canonical = new URL(Astro.url.pathname.replace(/(index)?\.html$/, ""), Astro.site);
const ogImage = new URL("/og.png", Astro.site);

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "FinancialService",
    name: "FinUp",
    url: Astro.site!.href,
    logo: new URL("/apple-touch-icon.png", Astro.site).href,
    image: ogImage.href,
    description,
    email: contact.email,
    telephone: contact.phone,
    address: { "@type": "PostalAddress", streetAddress: contact.address, addressLocality: "Улаанбаатар", addressCountry: "MN" },
    areaServed: "MN",
    sameAs: [contact.facebook, contact.instagram, appLinks.ios, appLinks.android],
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faqs.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })),
  },
];
---

<!doctype html>
<html lang="mn">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0a1833" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="FinUp" />
    <meta property="og:locale" content="mn_MN" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="apple-itunes-app" content="app-id=6779099419" />

    <!-- organization + FAQ schema describe the home page only -->
    {canonical.pathname === "/" && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    <!-- Mongolian text is mostly the Cyrillic subset (Ө Ү live in the tiny Cyrillic Ext one, inlined by Vite) -->
    <link rel="preload" href={manropeCyrillic} as="font" type="font/woff2" crossorigin />
    <!-- splash intro on every full load (skipped for reduced motion); set before first paint so it never flashes -->
    {intro && (
      <script is:inline>
        if (!matchMedia("(prefers-reduced-motion: reduce)").matches) document.documentElement.classList.add("intro");
      </script>
    )}
  </head>
  <body class="grid-bg">
    <!-- splash intro: pure CSS (global.css) so it runs before any JS -->
    <div id="loader" aria-hidden="true" class="fixed inset-0 z-[100] place-items-center overflow-hidden bg-night">
      <div class="pointer-events-none absolute -top-[30%] -left-[20%] size-[70vmax] rounded-full bg-[radial-gradient(circle,rgb(1_174_118/.35),transparent_60%)]"></div>
      <div class="pointer-events-none absolute -right-[25%] -bottom-[35%] size-[70vmax] rounded-full bg-[radial-gradient(circle,rgb(4_44_83/1),transparent_60%)]"></div>
      <div data-loader-inner class="relative flex flex-col items-center gap-9">
        <div class="flex font-display text-[clamp(64px,11vw,120px)] leading-[1.15] font-bold tracking-[-.05em]">
          {["F", "i", "n"].map((l, i) => <span data-l style={`--i:${i}`} class="inline-block text-white">{l}</span>)}
          {["U", "p"].map((l, i) => <span data-l data-up style={`--i:${i + 3}`} class="jump-letter">{l}</span>)}
        </div>
        <div class="glass h-3 w-60 overflow-hidden rounded-full p-[3px]">
          <span data-bar class="block h-full rounded-full bg-linear-to-r from-green to-mint shadow-[0_0_14px_var(--color-mint)]"></span>
        </div>
        <span data-pct class="font-display text-xs tracking-[.35em] text-muted tabular-nums"></span>
      </div>
    </div>

    <!-- ambient light for the glass to refract -->
    <div aria-hidden="true" class="pointer-events-none fixed inset-0 -z-10 overflow-hidden">
      <div class="absolute -top-[25%] -left-[15%] size-[65vmax] rounded-full bg-[radial-gradient(circle,rgb(1_174_118/.28),transparent_62%)]"></div>
      <div class="absolute top-[25%] -right-[20%] size-[60vmax] rounded-full bg-[radial-gradient(circle,rgb(4_44_83/.95),transparent_62%)]"></div>
      <div class="absolute -bottom-[30%] left-[15%] size-[55vmax] rounded-full bg-[radial-gradient(circle,rgb(96_224_130/.14),transparent_62%)]"></div>
    </div>

    <div id="progress" class="fixed inset-x-0 top-0 z-[60] h-[2px] origin-left scale-x-0 bg-linear-to-r from-green via-mint to-[#b6f5c6] shadow-[0_0_12px_var(--color-mint)]"></div>

    <!-- custom cursor (desktop only, enabled in motion.ts): trailing ring + precise dot -->
    <div id="cursor-ring" aria-hidden="true" class="pointer-events-none fixed top-0 left-0 z-[90] hidden size-9 rounded-full border border-mint/60">
      <span id="cursor-label" class="absolute inset-0 grid place-items-center font-display text-[11px] font-bold tracking-[.12em] whitespace-nowrap text-mint uppercase opacity-0"></span>
    </div>
    <div id="cursor-dot" aria-hidden="true" class="pointer-events-none fixed top-0 left-0 z-[91] hidden size-1.5 rounded-full bg-mint shadow-[0_0_10px_var(--color-mint)]"></div>

    <div class="grain pointer-events-none fixed inset-0 z-[80] opacity-[.025]"></div>

    <slot />

    <script>
      import "../scripts/motion";
      import { appLinks } from "../data/site";

      // "Апп татах" / "Зээл авах": straight to the store. Phones get their own store;
      // desktops get the App Store on a Mac, Google Play elsewhere, in a new tab
      const ua = navigator.userAgent;
      const touchMac = /Macintosh/.test(ua) && navigator.maxTouchPoints > 1; // iPadOS reports as Mac
      const ios = /iPhone|iPad|iPod/.test(ua) || touchMac;
      const android = /Android/i.test(ua);
      const store = ios || (!android && /Macintosh/.test(ua)) ? appLinks.ios : appLinks.android;
      document.querySelectorAll<HTMLAnchorElement>("[data-app-link]").forEach((a) => {
        a.href = store;
        if (!ios && !android) {
          a.target = "_blank";
          a.rel = "noopener";
        }
      });
    </script>
  </body>
</html>
